{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/server.py": {
      "maxDuration": 60,
      "includeFiles": "{app/static/**,knowledge/index.json,knowledge/vectors.json}",
      "excludeFiles": "{tests/**,evaluation/**,scripts/**,knowledge/sources/**,knowledge/manifest.json,docs/**,output/**,.venv/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-store, no-transform"}]
    }
  ]
}
