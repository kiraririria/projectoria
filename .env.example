# Ключ OpenRouter. Для локального запуска скопируйте этот файл в .env.
OPENROUTER_API_KEY=

# Модель должна поддерживать response_format: json_object.
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash

# Изменение модели требует пересборки knowledge/vectors.json. Пустое значение отключает эмбеддинги.
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3

# Пусто по умолчанию. Пример для эксперимента: qwen/qwen3-reranker-0.6b.
OPENROUTER_RERANK_MODEL=
