# ==========================================
# OpenRouter — API
# ==========================================

# API-ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ==========================================
# Chat Model
# ==========================================

# Модель должна поддерживать response_format: json_object
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash

# ==========================================
# Embeddings
# ==========================================

# Используется для векторного поиска.
# При смене модели необходимо пересобрать knowledge/vectors.json.
# Пустое значение отключает эмбеддинги.
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3

# ==========================================
# Reranking
# ==========================================

# Повторное ранжирование результатов поиска.
# Пустое значение отключает реранкинг.
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-0.6b

# Telegram: только сервер; пустой токен отключает отправку.
TELEGRAM_CHAT_ID=-5336363160
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_FEEDBACK_ENABLED=true

# Общие лимиты Vercel: без Redis отправка отзывов и ошибок отключена.
# Vercel Marketplace добавляет эту пару автоматически; значения не коммитить.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Альтернативная пара для ручного подключения. Приоритет у KV_REST_API_*.
# Пары не смешиваются; READ_ONLY_TOKEN, KV_URL и REDIS_URL не используются.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Случайный секрет длиной минимум 32 символа; одинаковый на всех инстансах.
FEEDBACK_HASH_SECRET=
